{
  "version": 1,
  "global": {
    "fontFamily": "Arial, sans-serif",
    "textColor": "#1f2937",
    "backgroundColor": "#ffffff",
    "contentWidth": 600
  },
  "blocks": {
    "text": {
      "fontSize": 16,
      "lineHeight": 1.5,
      "padding": "12px 16px"
    },
    "image": {
      "padding": "8px 0",
      "borderRadius": 6,
      "align": "center"
    },
    "button": {
      "padding": "10px 18px",
      "backgroundColor": "#2563eb",
      "textColor": "#ffffff",
      "borderRadius": 6,
      "fontWeight": 600
    },
    "divider": {
      "color": "#e5e7eb",
      "thickness": 1,
      "padding": "10px 0"
    },
    "spacer": {
      "height": 20
    },
    "columns": {
      "gap": 12,
      "stackOnMobile": true
    },
    "social": {
      "iconSize": 24,
      "padding": "12px 16px",
      "align": "center"
    }
  }
}
